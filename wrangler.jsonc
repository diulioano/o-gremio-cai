{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "o-gremio-cai",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-10-01",
  "routes": [
    { "pattern": "vaicair.diuliano.com", "custom_domain": true },
    // subdomínios antigos, já compartilhados: o Worker redireciona para vaicair.diuliano.com/<time>
    { "pattern": "o-gremio-cai.diuliano.com", "custom_domain": true },
    { "pattern": "o-inter-cai.diuliano.com", "custom_domain": true },
    { "pattern": "o-corinthians-cai.diuliano.com", "custom_domain": true },
    { "pattern": "o-vasco-cai.diuliano.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    // saída do build do cliente (vite build); o @cloudflare/vite-plugin e os testes do Worker usam esta pasta
    "directory": "./dist/client",
    "binding": "ASSETS",
    // páginas (caminhos sem extensão: /, /inter, /api/data) passam pelo Worker; arquivos (.js, .svg) vão direto
    "run_worker_first": ["/*", "!/*.*"]
  },
  "kv_namespaces": [
    { "binding": "CACHE" }
  ]
}
